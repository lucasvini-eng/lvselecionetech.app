# =====================================================================
# LVSelecioneTech — variáveis de ambiente (copie para .env e preencha)
# Nunca faça commit do arquivo .env.
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND (Vite) — tudo com prefixo VITE_ fica PÚBLICO no navegador.
# NÃO coloque senhas, tokens ou chaves aqui.
# ---------------------------------------------------------------------
# E-mail exibido no rodapé (opcional, só exibição)
VITE_PUBLIC_CONTACT_EMAIL=
# URL base da API (vazio = mesma origem / proxy do Vite em desenvolvimento)
VITE_API_BASE_URL=
# true = lista os produtos a partir do backend (GET /api/products); false = usa src/data/products.js
VITE_USE_API=false

# ---------------------------------------------------------------------
# BACKEND (server/) — SEGREDOS: ficam apenas no servidor.
# ---------------------------------------------------------------------
PORT=3001
# Origens permitidas via CORS, separadas por vírgula (ex.: https://seusite.com.br). Vazio = só mesma origem.
CORS_ORIGINS=http://localhost:5173
# Atrás de proxy/Nginx/PaaS, defina 1 para o limite de envios enxergar o IP real
TRUST_PROXY=
# true = o backend também serve a pasta dist/ (deploy em um único serviço)
SERVE_STATIC=false

# --- Feedback por e-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente (opcional; padrão = SMTP_USER)
MAIL_FROM=
# E-mail administrativo que recebe os feedbacks (definido por você)
FEEDBACK_TO_EMAIL=

# --- Administração de produtos ---
# Token longo e aleatório (mínimo 16 caracteres). Ex.: openssl rand -hex 32
ADMIN_TOKEN=

# --- Fontes oficiais de dados (opcionais) ---
# Mercado Livre: app criado em developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Shopee: credenciais da Affiliate Open API (programa de afiliados)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
